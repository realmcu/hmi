Import('SDK_ROOT')
from building import *

# get current directory
cwd = GetCurrentDir()


CPPDEFINES = []
LINKFLAGS = []


src = Glob('*.c')
path = [cwd]



group = DefineGroup('FlashDB', src, depend = [''], CPPPATH = path, CPPDEFINES = CPPDEFINES, LINKFLAGS = LINKFLAGS)


Return('group')
