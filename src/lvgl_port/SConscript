# RT-Thread building script for GuiEngine demo

from building import *

cwd = GetCurrentDir()
src = Split("""
""")

src = Glob('*.c')
CPPPATH = [cwd]
CPPDEFINES = ['LV_KCONFIG_IGNORE']
CPPDEFINES += ['LV_CONF_INCLUDE_SIMPLE']
# CPPDEFINES += ['LV_CONF_SKIP']
CPPDEFINES += ['LV_LVGL_H_INCLUDE_SIMPLE']
CPPDEFINES += ['LV_USE_DEMO_BENCHMARK']
CPPDEFINES += ['LV_USE_DEMO_WIDGETS']
CPPDEFINES += ['ENABLE_LVGL_GUI']

group = DefineGroup('port_lvgl', src, depend = ['CONFIG_REALTEK_BUILD_LVGL_V9'], CPPPATH = CPPPATH, CPPDEFINES = CPPDEFINES)

Return('group')
