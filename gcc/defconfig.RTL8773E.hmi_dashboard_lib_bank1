# HMI Dashboard - Use Precompiled GUI Library
# defconfig for RTL8773E 16M Flash Bank1

# Basic Configuration
CONFIG_REALTEK_8773E_DEVICE=y
CONFIG_SOC_RTL8773EWE_VP=y
CONFIG_REALTEK_FLASH_MAP_16M=y
CONFIG_REALTEK_COMPILE_BANK1=y
CONFIG_REALTEK_APP_COMMON=y
CONFIG_REALTEK_APP_CFU_TRANSFER_ENABLE=y
CONFIG_REALTEK_APP_COMMON_CFU_ENABLE=y
CONFIG_REALTEK_APP_DSP_CONFIG_ENABLE=y
CONFIG_REALTEK_APP_ONE_WIRE_UART_ENABLE=y
CONFIG_REALTEK_APP_NREC_ENABLE=y
CONFIG_REALTEK_APP_SIDETONE_ENABLE=y
CONFIG_REALTEK_HAL=y
CONFIG_REALTEK_DUAL_AUDIO_EFFECT=y
CONFIG_REALTEK_FILESYSTEM=y
CONFIG_REALTEK_SYSM=y
CONFIG_SOC_SERIES_RTL8773E=y
CONFIG_REALTEK_BTM=y
CONFIG_REALTEK_BLE_MGR=y
CONFIG_REALTEK_BTM_PAN_SUPPORT=y

# HMI Dashboard Application
CONFIG_REALTEK_APP_HMI_DASHBOARD_SUPPORT=y

# GUI Build Mode - Precompiled Library
CONFIG_REALTEK_GUI=y
CONFIG_REALTEK_HONEYGUI=y
CONFIG_REALTEK_HONEYGUI_BUILD_LIB=y

# App UI Source - Dashboard Designer (LIB mode has no example tree to conflict)
CONFIG_REALTEK_BUILD_DASHBOARD_DESIGNER=y

# Display Driver Configuration
CONFIG_REALTEK_DISPLAY=y
CONFIG_REALTEK_DISPLAY_GUI_ACC=y
CONFIG_REALTEK_DISPLAY_ENABLE_IDU=y
CONFIG_REALTEK_DISPLAY_ENABLE_LCDC=y
CONFIG_REALTEK_DISPLAY_ENABLE_PPE=y

# Device Configuration
CONFIG_REALTEK_LCD_ST7265_800_480_RGB=y
CONFIG_REALTEK_ROMFS=y

# Build cJSON
CONFIG_REALTEK_BUILD_CJSON=y
