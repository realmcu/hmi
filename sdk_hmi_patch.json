{
    "_comment": "Patch config for SDK_HMI.py sdk_package: use hmi_app instead of hmi, keep only chargecase+dashboard; add gui source without build artifacts",
    "replace_add": {
        "sdk/board/evb/hmi": [
            ["sdk/board/evb/hmi_app/chargecase", "board/evb/hmi_app/chargecase"],
            ["sdk/board/evb/hmi_app/dashboard",  "board/evb/hmi_app/dashboard"]
        ]
    },
    "extra_add": [
        ["sdk/src/sample/gui", "src/sample/gui"],
