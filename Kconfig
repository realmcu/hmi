menu "DeskMate Application"

config RTK_BT_BREDR
	bool "Enable Classic Bluetooth (BR/EDR) support"
	default n
	select REALTEK_SUBSYS_BTM
	select REALTEK_SUBSYS_SYSM
	select REALTEK_SUBSYS_REMOTE
	help
	  Enable Realtek Classic Bluetooth BR/EDR stack.
	  Activates BTM, SYSM, and Remote subsystems.

config RTK_BR_PROFILE_A2DP
	bool "Enable A2DP profile (Sink + Source)"
	depends on RTK_BT_BREDR
	default n

config RTK_BR_PROFILE_AVRCP
	bool "Enable AVRCP profile (CT + TG)"
	depends on RTK_BT_BREDR
	default n

config RTK_BR_PROFILE_HFP
	bool "Enable HFP profile (HF + AG)"
	depends on RTK_BT_BREDR
	default n

config RTK_BR_PROFILE_PAN
	bool "Enable PAN profile (PANU + NAP)"
	depends on RTK_BT_BREDR
	default n

config WATCH_UI
	bool "Build the watch_ui product UI (HoneyGUI Designer project)"
	depends on REALTEK_HONEYGUI
	default n
	help
	  Compile the smartwatch_ui_360360 product UI, i.e. the west project
	  "watch_ui" checked out at <west topdir>/ui, into the app image.

	  The UI supplies its own GUI_INIT_APP_EXPORT(app_init) entry, so it is
	  mutually exclusive with the HoneyGUI demo apps that export the same
	  symbol (REALTEK_BUILD_REAL_CANVAS and friends) -- enabling two of them
	  makes the link fail on a duplicate __honeygui_init_app_init.

	  Note: the UI reads its images and fonts from a romfs image that must be
	  flashed to USER_DATA1 (0x704D1000) separately; this option only covers
	  the C sources.

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
