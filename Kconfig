menu "DeskMate Application"

config RTK_BT_BREDR
	bool "Enable Classic Bluetooth (BR/EDR) support"
	default n
	select REALTEK_SUBSYS_BTM
	select REALTEK_SUBSYS_SYSM
	select REALTEK_SUBSYS_REMOTE
	help
	  Enable Realtek Classic Bluetooth BR/EDR stack.
	  Activates BTM, SYSM, and Remote subsystems.

config RTK_BR_PROFILE_A2DP
	bool "Enable A2DP profile (Sink + Source)"
	depends on RTK_BT_BREDR
	default n

config RTK_BR_PROFILE_AVRCP
	bool "Enable AVRCP profile (CT + TG)"
	depends on RTK_BT_BREDR
	default n

config RTK_BR_PROFILE_HFP
	bool "Enable HFP profile (HF + AG)"
	depends on RTK_BT_BREDR
	default n

config RTK_BR_PROFILE_PAN
	bool "Enable PAN profile (PANU + NAP)"
	depends on RTK_BT_BREDR
	default n

# ============================================================
# TensorFlow Lite Micro + CMSIS-NN
# ============================================================

config APP_TFLITE_MICRO
	bool "Enable TensorFlow Lite Micro (hello_world demo)"
	default n
	help
	  Build the TFLite Micro runtime and the hello_world demo
	  under port/tflite_micro/. Provides shell command `tflm`
	  (subcommands: float / int8 / all) for on-device inference.

config APP_CMSIS_NN
	bool "Enable CMSIS-NN kernels (Cortex-M55 Helium/MVE)"
	depends on APP_TFLITE_MICRO
	default n
	help
	  Build the ARM CMSIS-NN v6.0.0 library from component/cmsis-nn/
	  and use its optimized int8 kernels in TFLite Micro.
	  On Cortex-M55 with Helium (MVE) this accelerates int8 GEMM/
	  conv/depthwise significantly. Defining CMSIS_NN also switches
	  TFLM's kernels/fully_connected.h dispatch to the external
	  cmsis_nn/fully_connected.cc implementation.

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
