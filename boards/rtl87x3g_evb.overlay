#include <zephyr/dt-bindings/pinctrl/rtl87x3g-pinctrl.h>
#include <zephyr/dt-bindings/gpio/realtek-rtl87x3g-gpio.h>
#include <rtl87x3g-display-lcd.dtsi>

/ {
	chosen {
		zephyr,console = &uart2;
		zephyr,shell-uart = &uart2;
		zephyr,display = &display_lcd;
	};
};

&display_lcd {
	status = "okay";
};

&uart2 {
	status = "okay";
	current-speed = <2000000>;
};

&pinctrl {
	/* Override board default (P3_1/P3_0): route console UART2 to P1_1(TX)/P1_0(RX) */
	uart2_default: uart2_default {
		group1 {
			psels =
				<RTL87X3G_PSEL(UART2_TX, P1_1, DIR_OUT, DRV_HIGH, PULL_UP)>,
				<RTL87X3G_PSEL(UART2_RX, P1_0, DIR_IN,  DRV_HIGH, PULL_UP)>;
		};
	};
	uart2_sleep: uart2_sleep {
		group1 {
			psels = <RTL87X3G_PSEL(SW_MODE, P1_1, DIR_OUT, DRV_HIGH, PULL_UP)>;
		};
		group2 {
			psels = <RTL87X3G_PSEL(SW_MODE, P1_0, DIR_IN, DRV_HIGH, PULL_UP)>;
			wakeup-low;
		};
	};

	sdhc0_default: sdhc0_default {
		group1 {
			psels =
				<RTL87X3G_PSEL(HS_P5_0_SDH0_CLK,   P5_0, DIR_OUT, DRV_HIGH, PULL_UP)>,
				<RTL87X3G_PSEL(HS_P5_1_SDH0_CMD,   P5_1, DIR_OUT, DRV_HIGH, PULL_UP)>,
				<RTL87X3G_PSEL(HS_P5_2_SDH0_DATA0, P5_2, DIR_OUT, DRV_HIGH, PULL_UP)>;
			bias-pull-strong;
		};
	};

	uart3_default: uart3_default {
		group1 {
			psels =
				<RTL87X3G_PSEL(UART3_TX, P5_4, DIR_OUT, DRV_HIGH, PULL_UP)>,
				<RTL87X3G_PSEL(UART3_RX, P5_5, DIR_IN,  DRV_HIGH, PULL_UP)>;
		};
	};
	uart3_sleep: uart3_sleep {
		group1 {
			psels = <RTL87X3G_PSEL(SW_MODE, P5_4, DIR_OUT, DRV_HIGH, PULL_UP)>;
		};
		group2 {
			psels = <RTL87X3G_PSEL(SW_MODE, P5_5, DIR_IN, DRV_HIGH, PULL_UP)>;
			wakeup-low;
		};
	};

	/*
	 * i2c1_default / i2c1_sleep were removed together with the touch panel,
	 * see the "touch panel removed" note at the end of this file.
	 */
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&uart3 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart3_default>;
	pinctrl-1 = <&uart3_sleep>;
	pinctrl-names = "default", "sleep";
	dmas = <&dma0 2 49 0xa>, <&dma0 3 48 0x10021>;
	dma-names = "rx", "tx";
};

&dma0 {
	status = "okay";
};

&sdhc0 {
	pin-group = <0>;
	bus-width = <1>;
	max-bus-freq = <50000000>;
	pinctrl-0 = <&sdhc0_default>;
	pinctrl-names = "default";
	status = "okay";
};

/ {
	aliases {
		sdhc0 = &sdhc0;
		wifi-int = &wifi_int;
		uart3 = &uart3;
	};
	gpio_devs {
		compatible = "gpio-keys";
		wifi_int: wifi_int {
			gpios = <&gpiob 18 GPIO_ACTIVE_LOW>;  /* P5_3 */
			label = "wifi int";
		};
	};

	/*
	 * Panel keys driven by the realtek,gpio-keys driver. Each child is read
	 * through gpio_button_read_key()/gpio_button_register_callback() with its
	 * key,id, see port/ui/gui_port_indev.c for the Home/Menu/Power mapping.
	 *
	 * The MFB (multi function button, used as Back) is a dedicated pad that
	 * is not part of the GPIO controller, so it is handled through the MFB
	 * API and has no node here.
	 */
	gpio_keys: gpio_keys {
		compatible = "realtek,gpio-keys";
		debounce-interval-ms = <30>;

		key1: key1 {            /* Home, P3_0 */
			gpios = <&gpioa 23 (GPIO_ACTIVE_LOW | GPIO_PULL_UP |
					     RTL87X3G_GPIO_INPUT_PM_WAKEUP)>;
			label = "key1";
			key,id = <100>;
			status = "okay";
		};

		key2: key2 {            /* Power, ADC_0 = P0_0 */
			gpios = <&gpioa 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "key2";
			key,id = <101>;
			/*
			 * P0_0 is shared with I2C1_CLK on the EVB. The touch panel was
			 * removed (see below), so the pad is free for this key.
			 */
			status = "okay";
		};

		key3: key3 {            /* Menu, P3_1 */
			gpios = <&gpioa 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "key3";
			key,id = <102>;
			status = "okay";
		};
	};
};

/*
 * Touch panel removed.
 *
 * The CHSC6417 panel used i2c1 (SCL = P0_0/ADC_0, SDA = P0_1/ADC_1) plus
 * P0_2 (IRQ) and P0_3 (reset). P0_0 is the pad of key2 (Power), so the whole
 * panel is dropped here and the bus stays disabled.
 *
 * To bring the panel back: enable i2c1 (400 kHz) with an i2c1 pinctrl group,
 * add the chipsemi,chsc6417 child again, restore the i2c1_default/i2c1_sleep
 * pinctrl groups, turn CONFIG_REALTEK_TOUCH_CHSC6417_ZEPHYR back on in prj.conf,
 * and give key2 another pad.
 */
&i2c1 {
	status = "disabled";
};

