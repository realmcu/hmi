#include <zephyr/dt-bindings/pinctrl/rtl87x3g-pinctrl.h>
#include <zephyr/dt-bindings/gpio/realtek-rtl87x3g-gpio.h>
#include <rtl87x3g-display-lcd.dtsi>

/ {
	chosen {
		zephyr,console = &uart2;
		zephyr,shell-uart = &uart2;
		zephyr,display = &display_lcd;
	};
};

/ {
	/*
	 * Charger status input for 0x18 BATTERY's charge field.
	 *
	 * P5_2 = pad 38 = GPIOB17, driven by the charger IC: HIGH means charging.
	 * Active high is therefore the electrical truth, not a convention -- a
	 * gpio_pin_get_dt() of 1 is "charging" with no inversion anywhere.
	 *
	 * No pull is requested: the charger drives this line in both states, and a
	 * pull that fought it would only mask a disconnected pin -- which is exactly
	 * the fault worth seeing during bring-up.
	 *
	 * In /zephyr,user rather than a node of its own because a single input pin
	 * with no peripheral behind it does not earn a compatible + binding; Zephyr
	 * infers a binding for this path (gen_defines.py, infer_binding_for_paths).
	 *
	 * P5_2 appears as LCD_QSPI_RST in lcd_st77916_360_360_qspi.c, which is a
	 * different panel -- this board runs the ST7801N (RST=P4_0), so the pin is
	 * free here.  Confirmed against the hardware.
	 */
	zephyr,user {
		charger-status-gpios = <&gpiob 17 GPIO_ACTIVE_HIGH>;	/* P5_2 */
	};

	gpio_keys: gpio_keys{
		compatible = "realtek,gpio-keys";
		debounce-interval-ms = <30>;
		key1: key1{
			gpios = <&gpioa 25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP | RTL87X3G_GPIO_INPUT_PM_WAKEUP)>;
			label = "key1";
			key,id = <100>;
			status = "okay";
		};
	};
};

&display_lcd {
	status = "okay";
};

&uart2 {
	status = "okay";
	current-speed = <2000000>;
};


&pinctrl {
	uart3_default: uart3_default {
		group1 {
			psels =
				<RTL87X3G_PSEL(UART3_TX, P5_4, DIR_OUT, DRV_HIGH, PULL_UP)>,
				<RTL87X3G_PSEL(UART3_RX, P5_5, DIR_IN,  DRV_HIGH, PULL_UP)>;
		};
	};
	uart3_sleep: uart3_sleep {
		group1 {
			psels = <RTL87X3G_PSEL(SW_MODE, P5_4, DIR_OUT, DRV_HIGH, PULL_UP)>;
		};
		group2 {
			psels = <RTL87X3G_PSEL(SW_MODE, P5_5, DIR_IN, DRV_HIGH, PULL_UP)>;
			wakeup-low;
		};
	};
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&uart3 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart3_default>;
	pinctrl-1 = <&uart3_sleep>;
	pinctrl-names = "default", "sleep";
	dmas = <&dma0 2 49 0xa>, <&dma0 3 48 0x10021>;
	dma-names = "rx", "tx";
};

&dma0 {
	status = "okay";
};

&sdhc0 {
	status = "disabled";
};

&pinctrl {
	i2c2_default: i2c2_default {
		group1 {
			psels =
				<RTL87X3G_PSEL(I2C2_CLK, P2_3, DIR_OUT, DRV_HIGH, PULL_NONE)>,
				<RTL87X3G_PSEL(I2C2_DAT, P2_4, DIR_OUT, DRV_HIGH, PULL_NONE)>;
		};
	};
	i2c2_sleep: i2c2_sleep {
		group1 {
			psels =
				<RTL87X3G_PSEL(SW_MODE, P2_3, DIR_IN, DRV_LOW, PULL_UP)>,
				<RTL87X3G_PSEL(SW_MODE, P2_4, DIR_IN, DRV_LOW, PULL_UP)>;
		};
	};

	/* I2C0 (Gsensor): SCL=P5_0, SDA=P5_1 */
	i2c0_default: i2c0_default {
		group1 {
			psels =
				<RTL87X3G_PSEL(I2C0_CLK, P5_0, DIR_OUT, DRV_HIGH, PULL_NONE)>,
				<RTL87X3G_PSEL(I2C0_DAT, P5_1, DIR_OUT, DRV_HIGH, PULL_NONE)>;
		};
	};
	i2c0_sleep: i2c0_sleep {
		group1 {
			psels =
				<RTL87X3G_PSEL(SW_MODE, P5_0, DIR_IN, DRV_LOW, PULL_UP)>,
				<RTL87X3G_PSEL(SW_MODE, P5_1, DIR_IN, DRV_LOW, PULL_UP)>;
		};
	};
};

&i2c2 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-0 = <&i2c2_default>;
	pinctrl-1 = <&i2c2_sleep>;
	pinctrl-names = "default", "sleep";
	touch_device: touch_cst820@15 {
		compatible = "hynitron,cst820";
		reg = <0x15>;
		irq-gpios = <&gpiob 25 GPIO_ACTIVE_LOW>;		/* P3_5, falling edge */
		rst-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;	    /* P3_4 */
		pwr-en-gpios = <&gpioa 3 GPIO_ACTIVE_HIGH>;	    /* P0_3/ADC_3, VD33_EN, asserted first */
		pwr-gpios = <&gpioa 7 GPIO_ACTIVE_LOW>;		    /* P1_0, touch supply enable, active low */

	 	gesture-release-timeout-ms = <30>;
		status = "okay";
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* RTC：posix-device 的 /dev/rtc0（posix_port_rtc.c）编译期用
 * DEVICE_DT_GET(DT_NODELABEL(rtc))，需节点 status=okay 才会被实例化。 */
&rtc {
	status = "okay";
};
