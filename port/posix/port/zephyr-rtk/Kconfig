config POSIX_DEVICE_RTK_ZEPHYR
	bool "POSIX device abstraction layer for RTK8773G + Zephyr"
	default y
	help
	  Enable POSIX device abstraction layer for RTL8773G.
	  Provides open/close/read/write/ioctl for LCD/Touch/GPIO/UART/SPI.

config POSIX_DEVICE_LCD
	bool "POSIX LCD driver (RTK SH8601Z QSPI)"
	depends on POSIX_DEVICE_RTK_ZEPHYR
	default y

config POSIX_DEVICE_TOUCH
	bool "POSIX Touch driver (CHSC6417)"
	depends on POSIX_DEVICE_RTK_ZEPHYR
	default y

config POSIX_DEVICE_GSENSOR
	bool "POSIX G-Sensor driver (stub)"
	depends on POSIX_DEVICE_RTK_ZEPHYR
	default n

config POSIX_DEVICE_GPIO
	bool "POSIX GPIO driver (RTK SDK)"
	depends on POSIX_DEVICE_RTK_ZEPHYR
	default y

config POSIX_DEVICE_UART
	bool "POSIX UART driver (RTK SDK)"
	depends on POSIX_DEVICE_RTK_ZEPHYR
	default y
