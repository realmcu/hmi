{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "West Build",
      "type": "process",
      "command": "west",
      "args": ["build", "-b", "rtl87x3g_evb"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "West Rebuild",
      "type": "process",
      "command": "west",
      "args": ["build", "-b", "rtl87x3g_evb", "-p"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "West Flash (WSL)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/flash-wsl-app.sh",
      "args": ["COM13"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "West Flash (Native Linux)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/flash-linux-app.sh",
      "args": ["/dev/ttyUSB0"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "West Flash (Remote)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/flash-remote-app.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "West Flash (Windows)",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\flash-win32-app.bat",
      "args": ["COM4"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NOPAUSE": "1"
        }
      },
      "problemMatcher": []
    }
  ]
}
