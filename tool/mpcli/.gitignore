# At runtime mpcli creates log/YYYY_MM_DD/ next to the mpcli executable;
# ignore it so it does not pollute the repo.
log/

# --flash-runtime / --gen-json write the JSON and report into fw/runtime_system_bin/<CHIP>/;
# these are intermediate artifacts regenerated on every flash and are not committed.
fw/runtime_system_bin/*/flash_image.json
fw/runtime_system_bin/*/flash_image_report.txt

# Upstream sources may contain tar.gz / zip packaging intermediates; guard against accidental adds
*.tar.gz
*.zip
